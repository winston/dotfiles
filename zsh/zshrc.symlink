# Source starship.rs
eval "$(starship init zsh)"

# Customize to your needs...

source ~/.dotfiles/shell/common
source ~/.dotfiles/zsh/includes/config

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# Machine-local overrides
[ -f ~/.dotfiles/shell/work_only/config ] && source ~/.dotfiles/shell/work_only/config
