# Path
###############

export PATH="./bin:$PATH:$HOME/.local/bin:/Applications/Postgres.app/Contents/Versions/latest/bin:$HOME/.dotfiles/shell/scripts"
export EDITOR="vi"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# Aliases
###############

## Easier navigation: .., ..., ~ and -
alias ls="ls -alG"
alias ..="cd .."

alias ws="cd workspace"

## Claude
alias super="caffeinate -i tmux new -A -s boruto"

# Git
alias gpull="git pull"
alias gpush="git push"

alias gf="git fetch -p"
alias gb="git branch -a"
alias gs="git status"
alias ga="git add ."
alias gc="git commit"
alias gk="git checkout"
alias gd="git diff"
alias gl="git ll"

# zoxide (brew install zoxide)
###############

eval "$(zoxide init zsh)"

# mise
###############

eval "$(mise activate zsh)"
