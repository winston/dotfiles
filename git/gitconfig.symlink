[user]
	name = Winston
	email = winston.yongwei@gmail.com

[alias]
  st = status
  ll = log --pretty=oneline --abbrev-commit --max-count=15

[core]
  excludesfile = ~/.gitignore
  editor = vi

[credential]
	helper = osxkeychain

[diff]
	algorithm = histogram

[include]
  path = ~/.dotfiles/shell/work_only/gitconfig
