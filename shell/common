# Path
###############

export PATH="./bin:$PATH:$HOME/.local/bin:/Applications/Postgres.app/Contents/Versions/latest/bin:$HOME/.dotfiles/shell/scripts:$HOME/.dotfiles/shell/secret_scripts"
export EDITOR="vi"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# Aliases
###############

## Easier navigation: .., ..., ~ and -
alias ls="ls -alG"
alias ..="cd .."

alias ws="cd workspace"

## Databases
alias my_start="mysql.server start"
alias my_stop="mysql.server stop"

alias pg_start="open /Applications/Postgres.app"
alias pg_stop="pg_ctl stop -D '/Users/winston/Library/Application Support/Postgres/var-16'"

alias rd_start="redis-server /usr/local/etc/redis.conf"
alias es_start="elasticsearch --config=/usr/local/opt/elasticsearch/config/elasticsearch.yml"

## Claude
alias superclaude="caffeinate -i tmux new -A -s claude"

# Git
alias gpull="git pull"
alias gpush="git push"

alias gf="git fetch -p"
alias gb="git branch -a"
alias gs="git status"
alias ga="git add ."
alias gc="git commit"
alias gk="git checkout"
alias gd="git diff"
alias gl="git ll"
alias gx="gitx"

## Rails
alias rs="rails s --bind 0.0.0.0"
alias rc="rails c"
alias rd="rake db:migrate db:test:prepare"
alias srs="spring rails s --bind 0.0.0.0"
alias src="spring rails c"
alias sr="spring rspec"
alias ss="spring status"
alias ss="spring stop"
alias bi="bundle install --path vendor/bundle"
alias be="bundle exec"
alias er='export $(cat .env); bundle exec rspec'

# z (brew install z)
###############

. `brew --prefix`/etc/profile.d/z.sh

# asdf
###############

[[ -s "$(brew --prefix asdf)/libexec/asdf.sh" ]] && source "$(brew --prefix asdf)/libexec/asdf.sh"
