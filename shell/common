# Path
###############

export EDITOR="vi"

export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH:$HOME/.local/bin:$HOME/.dotfiles/shell/scripts"

# Aliases
###############

alias reload=". ~/.zshrc"

alias ls="ls -alG"
alias ..="cd .."

# Git
alias gpull="git pull"
alias gpush="git push"

alias gs="git status"
alias ga="git add ."
alias gc="git commit"
alias gk="git checkout"
alias gd="git diff"
alias gl="git ll"
alias gf="git fetch -p"
alias gb="git branch -a"

# zoxide (brew install zoxide)
###############

eval "$(zoxide init zsh)"

# mise
###############

eval "$(mise activate zsh)"
